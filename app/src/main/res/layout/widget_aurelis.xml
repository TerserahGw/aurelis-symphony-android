<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_shell"
    android:foreground="@drawable/widget_border" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:paddingLeft="12dp"
        android:paddingRight="11dp" android:paddingTop="11dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1.07"
            android:layout_height="match_parent" android:orientation="vertical"
            android:paddingRight="7dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="AURELIS  ·  NOW PLAYING" android:textColor="#BDDFD0"
                android:textStyle="bold" android:textSize="8sp" android:singleLine="true"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView android:id="@+id/widget_art"
                    android:layout_width="52dp" android:layout_height="52dp"
                    android:src="@drawable/widget_music_note"
                    android:background="@drawable/widget_album_frame"
                    android:clipToOutline="true" android:scaleType="centerCrop"
                    android:contentDescription="Cover lagu"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginLeft="9dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/widget_title"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:maxLines="2" android:ellipsize="end"
                        android:text="Aurelis Symphony" android:textColor="#F5FCF8"
                        android:textStyle="bold" android:textSize="12sp"/>
                    <TextView android:id="@+id/widget_artist"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" android:maxLines="1"
                        android:ellipsize="end" android:text="Musik untuk harimu"
                        android:textColor="#B6D0C5" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
                android:orientation="horizontal" android:gravity="center">
                <ImageView android:id="@+id/widget_prev" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="36dp"
                    android:padding="8dp" android:src="@drawable/widget_previous"
                    android:tint="#E3F7EC" android:contentDescription="Lagu sebelumnya"/>
                <ImageView android:id="@+id/widget_toggle" android:layout_width="0dp"
                    android:layout_weight="1.13" android:layout_height="36dp"
                    android:padding="7dp" android:src="@drawable/widget_play"
                    android:tint="#C9FFE3" android:contentDescription="Play atau pause"/>
                <ImageView android:id="@+id/widget_next" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="36dp"
                    android:padding="8dp" android:src="@drawable/widget_next"
                    android:tint="#E3F7EC" android:contentDescription="Lagu berikutnya"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight=".93"
            android:layout_height="match_parent" android:orientation="vertical"
            android:paddingLeft="10dp">
            <TextView android:id="@+id/widget_queue_header"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="UP NEXT" android:textColor="#BDDFD0"
                android:textSize="9sp" android:textStyle="bold"/>
                        <LinearLayout android:id="@+id/widget_next_one_row"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <ImageView android:id="@+id/widget_next_one_art"
                    android:layout_width="29dp" android:layout_height="29dp"
                    android:src="@drawable/widget_music_note"
                    android:background="@drawable/widget_album_frame"
                    android:clipToOutline="true" android:scaleType="centerCrop"
                    android:contentDescription="Cover lagu"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginLeft="7dp">
                    <TextView android:id="@+id/widget_next_one"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Lagu berikutnya" android:textColor="#F0F8F5"
                        android:textStyle="bold" android:textSize="10sp"
                        android:singleLine="true" android:ellipsize="end"/>
                    <TextView android:id="@+id/widget_next_one_artist"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="1dp" android:text="Artis"
                        android:textColor="#B5CAC4" android:textSize="9sp"
                        android:singleLine="true" android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
                        <LinearLayout android:id="@+id/widget_next_two_row"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <ImageView android:id="@+id/widget_next_two_art"
                    android:layout_width="29dp" android:layout_height="29dp"
                    android:src="@drawable/widget_music_note"
                    android:background="@drawable/widget_album_frame"
                    android:clipToOutline="true" android:scaleType="centerCrop"
                    android:contentDescription="Cover lagu"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginLeft="7dp">
                    <TextView android:id="@+id/widget_next_two"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Lagu berikutnya" android:textColor="#F0F8F5"
                        android:textStyle="bold" android:textSize="10sp"
                        android:singleLine="true" android:ellipsize="end"/>
                    <TextView android:id="@+id/widget_next_two_artist"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="1dp" android:text="Artis"
                        android:textColor="#B5CAC4" android:textSize="9sp"
                        android:singleLine="true" android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
                        <LinearLayout android:id="@+id/widget_next_three_row"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <ImageView android:id="@+id/widget_next_three_art"
                    android:layout_width="29dp" android:layout_height="29dp"
                    android:src="@drawable/widget_music_note"
                    android:background="@drawable/widget_album_frame"
                    android:clipToOutline="true" android:scaleType="centerCrop"
                    android:contentDescription="Cover lagu"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginLeft="7dp">
                    <TextView android:id="@+id/widget_next_three"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Lagu berikutnya" android:textColor="#F0F8F5"
                        android:textStyle="bold" android:textSize="10sp"
                        android:singleLine="true" android:ellipsize="end"/>
                    <TextView android:id="@+id/widget_next_three_artist"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="1dp" android:text="Artis"
                        android:textColor="#B5CAC4" android:textSize="9sp"
                        android:singleLine="true" android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
