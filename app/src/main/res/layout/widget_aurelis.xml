<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="3dp">
    <ImageView android:id="@+id/widget_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingLeft="16dp"
        android:paddingRight="16dp" android:paddingTop="12dp"
        android:paddingBottom="11dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="20dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="19dp" android:layout_height="19dp"
                android:src="@drawable/ic_aurelis_monochrome"
                android:tint="#BCEBD0" android:contentDescription="@null"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginLeft="6dp" android:text="A U R E L I S"
                android:textColor="#BCEBD0" android:textSize="10sp"
                android:textStyle="bold" android:singleLine="true"/>
            <Space android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView android:id="@+id/widget_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="NOW PLAYING" android:textColor="#92B1A5"
                android:textSize="9sp" android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="5dp">
            <ImageView android:id="@+id/widget_art"
                android:layout_width="62dp" android:layout_height="62dp"
                android:background="@drawable/widget_album_frame"
                android:clipToOutline="true" android:scaleType="centerCrop"
                android:src="@drawable/ic_aurelis_foreground"
                android:contentDescription="Cover lagu"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingLeft="12dp">
                <TextView android:id="@+id/widget_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Aurelis Symphony" android:textColor="#F3F8F5"
                    android:textStyle="bold" android:textSize="15sp"
                    android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/widget_artist"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Musik untuk harimu"
                    android:textColor="#B5C7BF" android:textSize="11sp"
                    android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
            android:orientation="horizontal" android:gravity="center_vertical|right">
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="SYMPHONY"
                android:textColor="#719689" android:textSize="9sp" android:letterSpacing=".19"/>
            <ImageView android:id="@+id/widget_prev"
                android:layout_width="42dp" android:layout_height="38dp"
                android:padding="9dp" android:src="@drawable/widget_previous"
                android:tint="#D3EEE1" android:contentDescription="Sebelumnya"/>
            <ImageView android:id="@+id/widget_toggle"
                android:layout_width="43dp" android:layout_height="43dp"
                android:padding="9dp" android:src="@drawable/widget_play"
                android:tint="#BCEBD0" android:contentDescription="Play atau pause"/>
            <ImageView android:id="@+id/widget_next"
                android:layout_width="42dp" android:layout_height="38dp"
                android:padding="9dp" android:src="@drawable/widget_next"
                android:tint="#D3EEE1" android:contentDescription="Berikutnya"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
