<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_shell"
    android:foreground="@drawable/widget_border" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="horizontal">
        <!-- The Now Playing pane is an edge-to-edge cover card with a
             GPU-preblurred lower half and a gentle dark readability fade. -->
        <FrameLayout android:layout_width="0dp" android:layout_weight="1.07"
            android:layout_height="match_parent">
            <ImageView android:id="@+id/widget_art"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_music_note" android:scaleType="centerCrop"
                android:contentDescription="Cover lagu"/>
            <FrameLayout android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_cover_bottom_blur"/>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="match_parent" android:orientation="vertical"
                android:paddingLeft="11dp" android:paddingRight="11dp"
                android:paddingTop="10dp" android:paddingBottom="7dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="AURELIS  ·  NOW PLAYING" android:textColor="#F0FFF9"
                    android:textStyle="bold" android:textSize="8sp" android:singleLine="true"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1"/>
                <TextView android:id="@+id/widget_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:text="Aurelis Symphony"
                    android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="12sp"/>
                <TextView android:id="@+id/widget_artist"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:layout_marginBottom="5dp"
                    android:maxLines="1" android:ellipsize="end"
                    android:text="Musik untuk harimu" android:textColor="#D6E9E2"
                    android:textSize="10sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="33dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/widget_prev"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="33dp" android:padding="7dp"
                    android:src="@drawable/widget_previous" android:tint="#F2FFF8"
                    android:contentDescription="Lagu sebelumnya"/>
                <ImageView android:id="@+id/widget_toggle"
                    android:layout_width="0dp" android:layout_weight="1.18"
                    android:layout_height="33dp" android:padding="6dp"
                    android:src="@drawable/widget_play" android:tint="#C4FFE4"
                    android:contentDescription="Play atau pause"/>
                <ImageView android:id="@+id/widget_next"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="33dp" android:padding="7dp"
                    android:src="@drawable/widget_next" android:tint="#F2FFF8"
                    android:contentDescription="Lagu berikutnya"/>
            </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <!-- Preserve the three real Up Next rows and artwork as before. -->
        <LinearLayout android:layout_width="0dp" android:layout_weight=".93"
            android:layout_height="match_parent" android:orientation="vertical"
            android:paddingLeft="10dp">
            <TextView android:id="@+id/widget_queue_header"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="UP NEXT" android:textColor="#BDDFD0"
                android:textSize="9sp" android:textStyle="bold"/>
                        <LinearLayout android:id="@+id/widget_next_one_row"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <ImageView android:id="@+id/widget_next_one_art"
                    android:layout_width="29dp" android:layout_height="29dp"
                    android:src="@drawable/widget_music_note"
                    android:background="@drawable/widget_album_frame"
                    android:clipToOutline="true" android:scaleType="centerCrop"
                    android:contentDescription="Cover lagu"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginLeft="7dp">
                    <TextView android:id="@+id/widget_next_one"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Lagu berikutnya" android:textColor="#F0F8F5"
                        android:textStyle="bold" android:textSize="10sp"
                        android:singleLine="true" android:ellipsize="end"/>
                    <TextView android:id="@+id/widget_next_one_artist"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="1dp" android:text="Artis"
                        android:textColor="#B5CAC4" android:textSize="9sp"
                        android:singleLine="true" android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
                        <LinearLayout android:id="@+id/widget_next_two_row"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <ImageView android:id="@+id/widget_next_two_art"
                    android:layout_width="29dp" android:layout_height="29dp"
                    android:src="@drawable/widget_music_note"
                    android:background="@drawable/widget_album_frame"
                    android:clipToOutline="true" android:scaleType="centerCrop"
                    android:contentDescription="Cover lagu"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginLeft="7dp">
                    <TextView android:id="@+id/widget_next_two"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Lagu berikutnya" android:textColor="#F0F8F5"
                        android:textStyle="bold" android:textSize="10sp"
                        android:singleLine="true" android:ellipsize="end"/>
                    <TextView android:id="@+id/widget_next_two_artist"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="1dp" android:text="Artis"
                        android:textColor="#B5CAC4" android:textSize="9sp"
                        android:singleLine="true" android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
                        <LinearLayout android:id="@+id/widget_next_three_row"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <ImageView android:id="@+id/widget_next_three_art"
                    android:layout_width="29dp" android:layout_height="29dp"
                    android:src="@drawable/widget_music_note"
                    android:background="@drawable/widget_album_frame"
                    android:clipToOutline="true" android:scaleType="centerCrop"
                    android:contentDescription="Cover lagu"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginLeft="7dp">
                    <TextView android:id="@+id/widget_next_three"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Lagu berikutnya" android:textColor="#F0F8F5"
                        android:textStyle="bold" android:textSize="10sp"
                        android:singleLine="true" android:ellipsize="end"/>
                    <TextView android:id="@+id/widget_next_three_artist"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="1dp" android:text="Artis"
                        android:textColor="#B5CAC4" android:textSize="9sp"
                        android:singleLine="true" android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
