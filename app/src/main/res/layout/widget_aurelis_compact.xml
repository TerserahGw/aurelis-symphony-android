<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_shell"
    android:foreground="@drawable/widget_border" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null"/>
    <ImageView android:id="@+id/widget_art"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_music_note" android:scaleType="centerCrop"
        android:contentDescription="Cover lagu"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/widget_cover_bottom_blur"
        android:clickable="false"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingLeft="11dp"
        android:paddingRight="11dp" android:paddingTop="10dp" android:paddingBottom="7dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="AURELIS  •  MUSIC" android:textSize="8sp" android:textStyle="bold"
            android:textColor="#EEFFF9" android:singleLine="true"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:clipChildren="true" android:clipToPadding="true">
            <TextView android:id="@+id/widget_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Aurelis Symphony" android:singleLine="true"
            android:ellipsize="end" android:textSize="12sp" android:textStyle="bold"
            android:textColor="#FFFFFFFF"
           
           
/>
            <ViewFlipper android:id="@+id/widget_title_flipper"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone"
                android:flipInterval="5000" android:autoStart="true"
                android:animateFirstView="false"
                android:inAnimation="@anim/widget_title_slide_in"
                android:outAnimation="@anim/widget_title_slide_out">
            <TextView android:id="@+id/widget_title_slide_one"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end"
                android:requiresFadingEdge="horizontal"
                android:fadingEdgeLength="9dp"
                android:textColor="#FAFFFD" android:textSize="12sp"
                android:textStyle="bold" android:text=""/>
            <TextView android:id="@+id/widget_title_slide_two"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end"
                android:requiresFadingEdge="horizontal"
                android:fadingEdgeLength="9dp"
                android:textColor="#FAFFFD" android:textSize="12sp"
                android:textStyle="bold" android:text=""/>

            </ViewFlipper>
        </FrameLayout>
        <TextView android:id="@+id/widget_artist"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:layout_marginBottom="5dp"
            android:text="Musik untuk harimu" android:singleLine="true"
            android:ellipsize="end" android:textSize="9sp"
            android:textColor="#D6E9E2"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="33dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/widget_prev"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="33dp" android:padding="7dp"
                    android:src="@drawable/widget_previous" android:tint="#F2FFF8"
                    android:contentDescription="Lagu sebelumnya"/>
                <ImageView android:id="@+id/widget_toggle"
                    android:layout_width="0dp" android:layout_weight="1.18"
                    android:layout_height="33dp" android:padding="6dp"
                    android:src="@drawable/widget_play" android:tint="#C4FFE4"
                    android:contentDescription="Play atau pause"/>
                <ImageView android:id="@+id/widget_next"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="33dp" android:padding="7dp"
                    android:src="@drawable/widget_next" android:tint="#F2FFF8"
                    android:contentDescription="Lagu berikutnya"/>
            </LinearLayout>
    </LinearLayout>
</FrameLayout>
