<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_shell"
    android:foreground="@drawable/widget_border" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="9dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="AURELIS  •  MUSIC" android:textSize="8sp" android:textStyle="bold"
            android:textColor="#C4F3E1" android:singleLine="true"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView android:id="@+id/widget_art" android:layout_width="55dp"
                android:layout_height="55dp" android:src="@drawable/widget_music_note"
                android:background="@drawable/widget_album_frame"
                android:clipToOutline="true" android:scaleType="centerCrop"
                android:contentDescription="Cover lagu"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:layout_marginLeft="7dp"
                android:orientation="vertical">
                <TextView android:id="@+id/widget_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Aurelis Symphony" android:maxLines="2"
                    android:ellipsize="end" android:textSize="12sp" android:textStyle="bold"
                    android:textColor="#FAFFFD"/>
                <TextView android:id="@+id/widget_artist"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="Musik untuk harimu"
                    android:singleLine="true" android:ellipsize="end"
                    android:textSize="9sp" android:textColor="#BDD4CA"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
            android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/widget_prev" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="34dp" android:padding="8dp"
                android:src="@drawable/widget_previous" android:tint="#E2F6ED"
                android:contentDescription="Lagu sebelumnya"android:background="@drawable/widget_control_secondary"
                android:layout_marginLeft="2dp" android:layout_marginRight="2dp"
                />
            <ImageView android:id="@+id/widget_toggle" android:layout_width="0dp" android:layout_weight="1.15"
                android:layout_height="34dp" android:padding="7dp"
                android:src="@drawable/widget_play" android:tint="#C8FFDF"
                android:contentDescription="Play atau pause"android:background="@drawable/widget_control_primary"
                android:layout_marginLeft="2dp" android:layout_marginRight="2dp"
                />
            <ImageView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="34dp" android:padding="8dp"
                android:src="@drawable/widget_next" android:tint="#E2F6ED"
                android:contentDescription="Lagu berikutnya"android:background="@drawable/widget_control_secondary"
                android:layout_marginLeft="2dp" android:layout_marginRight="2dp"
                />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
